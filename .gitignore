# Keep dataset/run metadata reproducible without committing the large payloads.
/DetectDataset/*
!/DetectDataset/data.yaml

# Ignore generated run directories by default, but retain the author's
# configuration and per-epoch metric history from the root runs archive.
runs/
!/runs/
!/runs/**/
!/runs/**/args.yaml
!/runs/**/results.csv

# Model weights and exported inference models
*.pt
*.pth
*.pth.tar
*.onnx
*.engine
*.torchscript

# Python caches and local environments
__pycache__/
*.py[cod]
*.cache
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/

# Experiment trackers and temporary output
wandb/
*.log

# Editor and operating-system metadata
.vscode/
.idea/
.DS_Store
